generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id                    BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  name                  String            @db.VarChar(120)
  email                 String            @unique @db.VarChar(190)
  passwordHash          String            @map("password_hash") @db.VarChar(255)
  type                  String            @default("online") @db.VarChar(10)
  phone                 String            @default("") @db.VarChar(40)
  isActive              Boolean           @default(true) @map("is_active")
  revenueGoal           Decimal           @default(18500) @map("revenue_goal") @db.Decimal(12, 2)
  createdAt             DateTime          @default(now()) @map("created_at")
  plans                 Plan[]
  members               Member[]
  finance               Finance[]
  notes                 Note[]
  checkins              Checkin[]
  appSubscriptions      AppSubscription[]

  @@map("admins")
}

model Plan {
  id      BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  adminId BigInt  @map("admin_id") @db.UnsignedBigInt
  months  Int
  fee     Decimal @db.Decimal(12, 2)
  admin   Admin   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, months])
  @@map("plans")
}

model Member {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  adminId        BigInt    @map("admin_id") @db.UnsignedBigInt
  name           String    @db.VarChar(150)
  email          String    @default("") @db.VarChar(190)
  phone          String    @default("") @db.VarChar(40)
  gender         String    @db.VarChar(30)
  age            Int
  plan           String    @db.VarChar(100)
  durationMonths Int       @map("duration_months")
  fee            Decimal   @db.Decimal(12, 2)
  joiningDate    DateTime  @map("joining_date")
  expiryDate     DateTime  @map("expiry_date")
  status         String    @default("active") @db.VarChar(20)
  notesText      String?   @map("notes") @db.Text
  keycard        String?   @db.VarChar(100)
  photoPath      String?   @map("photo_path") @db.VarChar(500)
  prKg           Decimal   @default(0) @map("pr_kg") @db.Decimal(10, 2)
  createdAt      DateTime  @default(now()) @map("created_at")
  admin          Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  finance        Finance[]
  notes          Note[]
  checkins       Checkin[]

  @@unique([adminId, keycard])
  @@index([adminId])
  @@map("members")
}

model Finance {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  adminId     BigInt   @map("admin_id") @db.UnsignedBigInt
  memberId    BigInt?  @map("member_id") @db.UnsignedBigInt
  memberName  String   @map("member_name") @db.VarChar(150)
  amount      Decimal  @db.Decimal(12, 2)
  type        String   @db.VarChar(40)
  plan        String   @default("") @db.VarChar(100)
  description String   @default("") @db.VarChar(500)
  paidAt      DateTime @default(now()) @map("paid_at")
  method      String   @default("Cash") @db.VarChar(40)
  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  member      Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([memberId])
  @@map("finance")
}

model Note {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  adminId   BigInt   @map("admin_id") @db.UnsignedBigInt
  memberId  BigInt   @map("member_id") @db.UnsignedBigInt
  title     String   @db.VarChar(200)
  body      String?  @db.Text
  tags      String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("notes")
}

model Checkin {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  adminId   BigInt   @map("admin_id") @db.UnsignedBigInt
  memberId  BigInt   @map("member_id") @db.UnsignedBigInt
  checkedAt DateTime @default(now()) @map("checked_at")
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([memberId])
  @@map("checkins")
}

model AppSubscription {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  adminId   BigInt   @map("admin_id") @db.UnsignedBigInt
  plan      String   @db.VarChar(20)
  price     Decimal  @db.Decimal(12, 2)
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  status    String   @default("active") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, endDate])
  @@map("app_subscriptions")
}
