# Copy to .env locally or configure securely on EC2; never commit real credentials.
NODE_ENV=production
HOST=0.0.0.0
PORT=3002
DATABASE_URL="mysql://APP_DB_USER:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:3306/rts_physioclinic"
JWT_SECRET=REPLACE_WITH_PHYSIO_ONLY_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=30d
SUPER_ADMIN_KEY=REPLACE_WITH_LONG_RANDOM_ADMIN_KEY
PANEL_ADMIN_EMAIL=panel-admin@example.com
PANEL_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# Comma-separated exact web origins; mobile native clients generally do not send Origin.
CORS_ORIGIN=https://admin.example.com
